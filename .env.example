# ByteMedicals + PRAG — ejemplo de configuración.
# Copia este archivo como ".env" y completa TUS valores.
# NUNCA escribas secretos reales aquí ni compartas el archivo .env.
# NUNCA subas .env ni gdrive_credentials.json a un repositorio.

# PRAG (servicio aparte, solo accesible desde este backend)
PRAG_BASE_URL=http://127.0.0.1:8001
# Claves de ejemplo para desarrollo local (las fijó Mauricio como
# ejemplos; deben ser IGUALES en el .env de prag/ y cambiarse antes
# de cualquier despliegue).
PRAG_USER_API_KEY=1111
PRAG_ADMIN_API_KEY=2222

# Secreto para firmar los tokens JWT de los usuarios.
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Cuenta administradora inicial (opcional): si los defines, al arrancar
# se crea ese usuario con rol admin (si no existe ya). Sin ellos no se
# crea ninguna cuenta admin automáticamente.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Base de datos MySQL (usuarios y conversaciones)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bytemedicals_db
