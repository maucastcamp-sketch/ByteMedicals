# PRAG — ejemplo de configuración (sin secretos reales).
# Copia este archivo como ".env" DENTRO de la carpeta prag/ y completa TUS valores.
# Las claves PRAG_USER_API_KEY y PRAG_ADMIN_API_KEY deben ser IGUALES
# a las del .env de la raíz del proyecto (el backend las usa para llamar a PRAG).

# LLM
MODEL_PROVIDER=ollama
CHAT_MODEL=qwen2.5:3b-instruct
GROQ_API_KEY=                         # solo si MODEL_PROVIDER=groq

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings (modelo elegido para ByteMedicals: multilingüe, 384 dimensiones)
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Qdrant (local; el tamaño debe coincidir con el modelo de embeddings)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=personal-rag
QDRANT_VECTOR_SIZE=384

# Google Drive (cuenta de servicio; el archivo va en prag/ y nunca se comparte)
GOOGLE_CREDENTIALS_PATH=gdrive_credentials.json
GOOGLE_CREDENTIALS_JSON=
DRIVE_FOLDER_ID=

# Claves de PRAG (ejemplos para desarrollo local; deben coincidir
# con el .env de la raíz y cambiarse antes de cualquier despliegue)
PRAG_USER_API_KEY=1111
PRAG_ADMIN_API_KEY=2222

# LangSmith (opcional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=personal-rag

ALLOWED_ORIGINS=http://127.0.0.1:8000

# Logging
LOG_LEVEL=WARNING

ENVIRONMENT=development
